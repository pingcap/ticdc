#!/bin/bash

set -eu

args=("$@")
has_max_restarts=0

for ((i = 0; i < ${#args[@]}; i++)); do
	if [ "${args[$i]}" = "--max-restarts" ]; then
		if [ $((i + 1)) -ge ${#args[@]} ] || ! [[ "${args[$((i + 1))]}" =~ ^[0-9]+$ ]]; then
			echo "--max-restarts requires a non-negative integer" >&2
			exit 1
		fi
		has_max_restarts=1
	fi
done

if [ "$has_max_restarts" -ne 1 ]; then
	echo "--max-restarts is required" >&2
	exit 1
fi

exec run_cdc_server "${args[@]}" --restart true
